{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Gateway Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Provision Gateway Memory Store",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.provision_memory_store"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Gateway Memory Pair Is Absent",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.verify_memory",
        "--key",
        "${input:memoryProofKey}",
        "--value",
        "${input:memoryProofValue}",
        "--expect-absent"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Verify Gateway Memory Pair",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.verify_memory",
        "--key",
        "${input:memoryProofKey}",
        "--value",
        "${input:memoryProofValue}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Sync Foundry Agent Metadata",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.sync_agent_metadata",
        "--environment",
        "${input:foundryEnvironment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Validate Gateway prerequisites",
      "type": "aitk",
      "command": "debug-check-prerequisites",
      "args": {
        "portOccupancy": [
          5679,
          8088
        ],
        "pyPackageInstalled": [
          "debugpy"
        ]
      }
    },
    {
      "label": "Run Gateway HTTP Server",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "debugpy",
        "--listen",
        "127.0.0.1:5679",
        "main.py"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "dependsOn": [
        "Validate Gateway prerequisites"
      ],
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^.*$",
            "file": 0,
            "location": 1,
            "message": 2
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Application startup complete|running on|Running on|Started server process|AgentServerHost started"
        }
      }
    },
    {
      "label": "Open Agent Inspector",
      "type": "shell",
      "command": "echo '${input:openAgentInspector}'",
      "presentation": {
        "reveal": "never"
      },
      "dependsOn": [
        "Run Gateway HTTP Server"
      ]
    },
    {
      "label": "Configure Incoming A2A v1.0",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.configure_a2a"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Run A2A Memory Test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "scripts.a2a_client"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/agent-framework-agent-foundry-memory-responses"
      },
      "problemMatcher": []
    },
    {
      "label": "Terminate All Tasks",
      "type": "shell",
      "command": "echo ${input:terminate}",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "memoryProofKey",
      "type": "promptString",
      "description": "Opaque key from the current proof (akg + 16 hex characters)"
    },
    {
      "id": "memoryProofValue",
      "type": "promptString",
      "description": "Independent value from the current proof (akv + 16 hex characters)"
    },
    {
      "id": "foundryEnvironment",
      "type": "promptString",
      "description": "azd environment to sync into local Foundry metadata",
      "default": "dev"
    },
    {
      "id": "openAgentInspector",
      "type": "command",
      "command": "ai-mlstudio.openTestTool",
      "args": {
        "triggeredFrom": "tasks",
        "port": 8088
      }
    },
    {
      "id": "terminate",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "terminateAll"
    }
  ]
}
